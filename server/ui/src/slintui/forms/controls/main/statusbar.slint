

import { Button } from "std-widgets.slint";
import "../../../resources/fa-solid-900.ttf";

export component StatusBar inherits Window {
    in property <color> backcolor;
    callback logoutcallback;

    default-font-family: "Font Awesome 6 Free";

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;
        alignment: LayoutAlignment.end;
        width: 100%;

        Rectangle {
            background: backcolor;
            width: 100%;
            height: 30px;

            HorizontalLayout {
                width: 100%;
                alignment: LayoutAlignment.end;
                padding-left: 5px;
                Button {
                    width: 30px;
                    text: "\u{f2f5}";
                    clicked => {
                        logoutcallback();
                    }
                }
            }
        }
    }
}
