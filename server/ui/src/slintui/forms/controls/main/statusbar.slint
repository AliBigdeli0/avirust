

import { Button } from "std-widgets.slint";
import "../../../resources/fa-solid-900.ttf";

export component StatusBar inherits HorizontalLayout {
    in property <color> backcolor;
    callback logoutcallback;

    padding: 0px;
    spacing: 0px;
    alignment: LayoutAlignment.end;

    Rectangle {
        background: backcolor;
        width: 100%;
        height: 100%;

        HorizontalLayout {
            width: 100%;
            height: root.height - 5px;
            alignment: LayoutAlignment.end;
            padding-right: 5px;
            Button {
                width: 40px;
                text: "👤";
                colorize-icon: false;
                clicked => {
                    logoutcallback();
                }
            }
        }
    }
}
