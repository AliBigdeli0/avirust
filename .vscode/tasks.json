{
  "version": "2.0.0",
  "group": {
    "kind": "build",
    "isDefault": true
  },
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "client"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
        }
      },
      "dependsOn":"linux_per_build",
    }, 
    {
      "label": "build_import_ui",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "import_ui"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
        }
      },
      "dependsOn":"linux_per_build",
    }, 
    {
      "label": "build_server_db",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "-p", "server_db"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
      },
      "dependsOn":"linux_per_build",
    }, 
    {
      "label": "linux_per_build", 
      "type": "shell", 
      "command": "make", 
      "args": ["copy_www_files"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
    }
  ]
}