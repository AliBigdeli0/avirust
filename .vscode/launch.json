{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Client",
            "program": "${workspaceFolder}/target/debug/client",
            "args": [],
            "cwd": "${workspaceFolder}/target/debug",
            "stopOnEntry": false, 
            "preLaunchTask": "build",
            "env": {
                "LD_LIBRARY_PATH": "${workspaceFolder}/target/debug/:${env:LD_LIBRARY_PATH}"
            },
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug UI",
            "program": "${workspaceFolder}/target/debug/ui",
            "args": [],
            "cwd": "${workspaceFolder}/target/debug",
            "stopOnEntry": false, 
            "preLaunchTask": "build",
            "env": {
                "LD_LIBRARY_PATH": "${workspaceFolder}/target/debug/:${env:LD_LIBRARY_PATH}"
            },
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Import UI",
            "program": "${workspaceFolder}/target/debug/import_ui",
            "args": ["-c"],
            "cwd": "${workspaceFolder}/target/debug",
            "stopOnEntry": false,
            "preLaunchTask": "linux_per_build", 
            "env": {
                "LD_LIBRARY_PATH": "${workspaceFolder}/target/debug/:${env:LD_LIBRARY_PATH}"
            },
        }
    ]
}